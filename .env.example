# Copy to .env locally. Never commit secrets.
# Do not put AWS access keys, secret keys, or session tokens in this file.

# Streamlit process settings. These are not secrets.
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Optional local AWS profile name. The CLI reads credentials from the
# AWS credential store, not from this repository.
# AWS_PROFILE=default
# AWS_REGION=us-east-1
